# =============================================================================
# Trading App Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Alpaca broker connection ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Database ---
# Leave empty for local SQLite file. On Railway, set to the PostgreSQL URL.
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- Server ---
PORT=8000
LOG_LEVEL=INFO

# --- Cache TTLs (seconds) ---
SIMPLE_CACHE_TTL=300
BG_CACHE_TTL=3600
MODEL_CACHE_TTL=3600

# --- Concurrency / workers ---
MAX_CONCURRENT_MODELS=1
BG_WORKER_COUNT=3
SCREENER_WORKERS=15

# --- Phase 2: Halal screening (Financial Modeling Prep) ---
FMP_API_KEY=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 5: API authentication ---
# Leave empty to disable authentication.
API_KEY=

# --- Risk management ---
RISK_CAPITAL=100000.0
RISK_PCT=1.0
