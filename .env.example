# =============================================================================
# Trading App Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Alpaca broker connection ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Alpaca MARKET-DATA credentials (data.alpaca.markets) ---
# IMPORTANT: The Data API requires SEPARATE credentials from the Trading API.
# You CANNOT use ALPACA_API_KEY here — it will return 401.
# Generate them at: Alpaca Dashboard → Paper Trading → API Keys → Data Key
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=

# --- Multi-Strategy Alpaca accounts ---
# Strategy A: Momentum Alpha (trend-following)
ALPACA_API_KEY_A=
ALPACA_SECRET_KEY_A=
# Strategy B: Mean Reversion (dip-buying)
ALPACA_API_KEY_B=
ALPACA_SECRET_KEY_B=
# Strategy C: AI Ensemble (pure ML)
ALPACA_API_KEY_C=
ALPACA_SECRET_KEY_C=

# --- Database ---
# Leave empty for local SQLite file. On Railway, set to the PostgreSQL URL.
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- Server ---
PORT=8000
LOG_LEVEL=INFO

# --- Cache TTLs (seconds) ---
SIMPLE_CACHE_TTL=300
BG_CACHE_TTL=3600
MODEL_CACHE_TTL=3600

# --- Concurrency / workers ---
MAX_CONCURRENT_MODELS=1
BG_WORKER_COUNT=3
SCREENER_WORKERS=15

# --- Market Data API keys ---
# Financial Modeling Prep: company profiles, sector, financials
FMP_API_KEY=

# Tiingo: OHLCV stock data (works great on servers, no 401 like Alpaca Data)
# Free tier: 500 symbols/day. Register at: https://api.tiingo.com
TIINGO_TOKEN=

# FRED: Federal Reserve economic data (VIX, yield spread, CPI, unemployment)
# Free. Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 5: API authentication ---
# Required for /admin/*, /ops, /portfolio/*, /strategy/* and /api/v1/trading/*.
# If left empty, those endpoints fail closed and auto-trading startup guards
# will disable AUTO_TRADE_ENABLED until a valid X-API-Key secret is set.
API_KEY=

# --- Broker selection ---
# Set to "alpaca" (default) or "ibkr"
# BROKER_TYPE=ibkr

# --- Interactive Brokers (IBKR) — when BROKER_TYPE=ibkr ---
# IBKR_HOST=127.0.0.1           # IB Gateway host
# IBKR_PORT=4002                # 4002=paper, 4001=live
# IBKR_CLIENT_ID=1

# --- Risk management ---
RISK_CAPITAL=100000.0
RISK_PCT=1.0
